{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "<azure-sql-connection-string>"
  },
  "Storage": {
    "ConnectionString": "<storage-account-connection-string>"
  },
  "Functions": {
    "BaseUrl": "https://<function-app-name>.azurewebsites.net",
    "Key": "<function-key>"
  },
  "AllowedHosts": "*"
}
